# WebSocket-URL für den Multiplayer-Modus.
# Aus dem Terraform-Output nach `npm run infra:apply`:
#   npm run --silent infra:apply  → ws_endpoint = "wss://..."
#
# Bei leerer Variable läuft die App im reinen Offline-Modus (Single-Device).
# Kopie diese Datei zu `.env.local` und trage den echten Endpoint ein.

VITE_WS_URL=wss://REPLACE_ME.execute-api.eu-central-1.amazonaws.com/dev
