{
  "name": "@quizapp/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared code between Vite frontend and AWS Lambda: types, data catalog, pure logic.",
  "type": "module",
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./data": "./src/data/index.ts",
    "./data/questions.json": "./src/data/questions.json",
    "./data/rounds.json": "./src/data/rounds.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
